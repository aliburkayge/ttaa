WP_URL=https://example.com
WP_USERNAME=
WP_APP_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# OpenAI — server-side only; never use NEXT_PUBLIC_ for this key
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_MODEL=gpt-5.5-2026-04-23
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x864
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=webp

# AY Tercüme — TTAA bilgilerinden tamamen ayrı; ileride doldurulacak
AY_SITE_URL=
AY_WP_URL=
AY_WP_USERNAME=
AY_WP_APP_PASSWORD=
AY_WHATSAPP_PHONE=
AY_SUPABASE_URL=
AY_SUPABASE_SERVICE_ROLE_KEY=
AY_SUPABASE_CONTENT_BUCKET=
AY_SUPABASE_IMAGE_BUCKET=

# AY görselleri — boş bırakılırsa genel OPENAI_IMAGE_* değerleri kullanılır
AY_OPENAI_IMAGE_MODEL=gpt-image-2
AY_OPENAI_IMAGE_SIZE=1536x864
AY_OPENAI_IMAGE_QUALITY=medium
AY_OPENAI_IMAGE_FORMAT=webp

# Durable Railway queue. Enable only after the content_jobs migration is applied
# and the ttaa-worker service reports a healthy heartbeat.
ASYNC_JOBS_ENABLED=false
OPENAI_BACKGROUND_MODE=true
PUBLIC_APP_URL=http://localhost:3000
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_RUNTIME_MS=2700000
OPENAI_RESPONSE_TIMEOUT_MS=480000
OPENAI_IMAGE_TIMEOUT_MS=240000
WORDPRESS_TIMEOUT_MS=60000
SUPABASE_REQUEST_TIMEOUT_MS=30000
JOB_RETENTION_DAYS=7
