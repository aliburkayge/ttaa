{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "build:railway": "next build",
    "start:railway": "node scripts/railway-start.mjs",
    "web:railway": "next start --hostname 0.0.0.0",
    "worker:railway": "tsx scripts/content-worker.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "test:wordpress": "node --import tsx --test tests/wordpress-target.test.ts",
    "test:quality": "node --import tsx --test tests/content-quality.test.ts tests/internal-links.test.ts",
    "test:qr": "node --import tsx --test tests/qr-prototype.test.ts tests/ay-verification-page.test.ts tests/ay-verification-wordpress.test.ts tests/ttaa-verification-page.test.ts tests/ttaa-verification-wordpress.test.ts tests/qr-request-origin.test.ts tests/ttaa-qr-records.test.ts tests/public-verification.test.ts",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:wordpress && npm run test:quality && npm run test:qr",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
